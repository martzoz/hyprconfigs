import QtQuick
import Quickshell
import Quickshell.Io

Item {
    id: root

    // ── Properties from shell.qml ──
    property string mpTitle:    "END OF EVANGELION"
    property string mpArtist:   "NEON GENESIS // ANNO"
    property string mpCoverUrl: ""
    property bool   mpPlaying:  false
    property real   mpPosition: 0
    property real   mpLength:   341

    // ── HudPanel needs tick + scanY — driven locally since Player has its own PanelWindow scope ──
    property int  tick:  0
    property real scanY: 0
    Timer { interval:500;  running:root.shown; repeat:true; onTriggered: root.tick  = (root.tick+1)%4 }
    Timer { interval:16;   running:root.shown; repeat:true; onTriggered: root.scanY = (root.scanY+1)%900 }

    signal playPause
    signal nextTrack
    signal prevTrack

    property bool   shown:    false
    property bool   isHiding: false
    property string clockStr: "--:--"

    readonly property int pw:     880
    readonly property int coverSz: 224

    function fmtTime(secs) {
        var s = Math.max(0, Math.floor(secs))
        return Math.floor(s/60) + ":" + String(s%60).padStart(2,"0")
    }

    Timer {
        interval: 1000; running: true; repeat: true
        onTriggered: {
            var d = new Date()
            root.clockStr = String(d.getHours()).padStart(2,"0") + ":"
                          + String(d.getMinutes()).padStart(2,"0")
        }
    }
    Component.onCompleted: {
        var d = new Date()
        clockStr = String(d.getHours()).padStart(2,"0") + ":" + String(d.getMinutes()).padStart(2,"0")
    }

    Process {
        id: seekProc
        property real seekSecs: 0
        command: ["playerctl", "position", String(Math.round(seekSecs))]
        running: false
    }

    IpcHandler {
        target: "player"
        function toggle(): void { root.toggleVisible() }
        function show(): void   { if (!root.shown) root.toggleVisible() }
        function hide(): void   { if ( root.shown) root.toggleVisible() }
    }

    function toggleVisible() {
        if (root.shown) {
            root.shown = false
            crtReveal.stop()
            crtHide.start()
        } else {
            root.shown = true
            crtHide.stop()
            wipeHost.visible = true
            wipeHost.forceActiveFocus()
            crtReveal.start()
        }
    }

    implicitWidth:  pw
    implicitHeight: wipeHost.height

    Item {
        id: wipeHost
        width: pw; height: mainCol.implicitHeight + 46
        clip: true; visible: false
        focus: true

        Keys.onPressed: event => {
            if (event.key === Qt.Key_Space) {
                root.playPause()
                event.accepted = true
            }
        }

        property real crtScale: 0.0
        transform: Scale {
            origin.x: pw / 2
            origin.y: wipeHost.height / 2
            xScale: 1.0
            yScale: wipeHost.crtScale
        }

        // CRT flash overlay
        Rectangle {
            id: crtFlash; anchors.fill: parent
            color: Qt.rgba(200/255, 184/255, 154/255, 1.0)
            opacity: 0; z: 100
        }

        // ── Full-bleed album art background — behind HudPanel ──
        Image {
            id: albumBgImg
            source: root.mpCoverUrl
            fillMode: Image.PreserveAspectCrop
            anchors.fill: parent
            anchors.margins: 1
            smooth: true
            opacity: 0.0
            visible: root.mpCoverUrl !== ""
            z: 0
            onStatusChanged: {
                if (status === Image.Ready) opacity = 0.05
                else opacity = 0.0
            }
            Behavior on opacity { NumberAnimation { duration: 1000 } }
        }

        // ── HudPanel chrome ──
        HudPanel {
            id: hudPanel
            anchors.fill: parent
            z: 1
            title: "PLAYER"; subtitle: "音楽プレーヤー"
            tickOverride:  root.tick
            scanYOverride: root.scanY

            // ── Main content ──
            Column {
                id: mainCol
                anchors.fill: parent
                anchors.topMargin: 0
                spacing: 0

                // ── Ticker — above cover ──
                Item {
                    width: parent.width; height: 22; clip: true
                    Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: 1; color: Qt.rgba(200/255,184/255,154/255,0.06) }
                    Text {
                        id: playerTicker
                        text: "◆ NR-2B  //  " + root.mpArtist + "  //  " + root.mpTitle + "  //  LOSSLESS 48kHz  //  NOW PLAYING  //  " + root.clockStr + "  //  "
                        font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:1.5
                        color:Qt.rgba(200/255,184/255,154/255,0.22); y:5
                        NumberAnimation on x {
                            id: playerTickerAnim
                            from: mainCol.width; to: -playerTicker.implicitWidth
                            duration: 26000; loops: Animation.Infinite
                            running: true; easing.type: Easing.Linear
                        }
                        Component.onCompleted: playerTickerAnim.restart()
                    }
                }

                // ── Cover + info row ──
                Row {
                    width: parent.width
                    height: coverSz + 28
                    spacing: 0

                    // ── Cover ──
                    Item {
                        id: coverArea
                        width: coverSz + 40; height: coverSz + 28

                        property var hoverIntensity: new Array(32*32).fill(0)
                        property var hoverR: new Array(32*32).fill(200)
                        property var hoverG: new Array(32*32).fill(184)
                        property var hoverB: new Array(32*32).fill(154)

                        Canvas {
                            id: coverMain
                            x: 20; y: 14
                            width: coverSz; height: coverSz
                            smooth: false

                            property var imgPixels:     null
                            property var nextImgPixels: null
                            property int blockStep:     0

                            onPaint: {
                                var ctx = getContext("2d")
                                var GRID = 32, SZ = coverSz, CELL = coverSz / 32.0
                                ctx.clearRect(0, 0, SZ, SZ)

                                if (!imgPixels) {
                                    var seed = root.mpTitle.length * 1234567 + root.mpArtist.length * 89 + 42
                                    function rand() { seed=(seed*16807+0)%2147483647; return(seed-1)/2147483646 }
                                    for (var r=0; r<GRID; r++) for (var cc=0; cc<GRID; cc++) {
                                        var n=rand(); var dx=(cc-GRID/2)/(GRID/2); var dy=(r-GRID/2)/(GRID/2)
                                        var d=Math.sqrt(dx*dx+dy*dy)
                                        var v=Math.max(0,Math.min(255,(1-d*0.55)*210+n*70-30))
                                        ctx.fillStyle="rgb("+Math.round(v)+","+Math.round(v)+","+Math.round(v)+")"
                                        var px = Math.floor(cc*CELL), py = Math.floor(r*CELL)
                                        var pw2 = Math.floor((cc+1)*CELL) - px - 1
                                        var ph2 = Math.floor((r+1)*CELL) - py - 1
                                        ctx.fillRect(px, py, Math.max(1,pw2), Math.max(1,ph2))
                                    }
                                    return
                                }

                                var bs = blockStep === 0 ? Math.round(CELL) : Math.max(1, Math.round(CELL) + blockStep)
                                var src = imgPixels
                                var cols = Math.ceil(SZ/bs), rows = Math.ceil(SZ/bs)
                                for (var row=0; row<rows; row++) for (var col=0; col<cols; col++) {
                                    var sx=Math.min(col*bs+Math.floor(bs/2),SZ-1)
                                    var sy=Math.min(row*bs+Math.floor(bs/2),SZ-1)
                                    var idx=(sy*SZ+sx)*4
                                    var lum=0.299*src[idx]+0.587*src[idx+1]+0.114*src[idx+2]
                                    var gv=Math.round(Math.min(255,Math.max(0,(lum-10)*(255/235))))
                                    ctx.fillStyle="rgb("+gv+","+gv+","+gv+")"
                                    var pw3 = Math.min(bs-1, SZ - col*bs - 1)
                                    var ph3 = Math.min(bs-1, SZ - row*bs - 1)
                                    ctx.fillRect(col*bs, row*bs, Math.max(1,pw3), Math.max(1,ph3))
                                }
                            }

                            Component.onCompleted: requestPaint()
                            Connections {
                                target: root
                                function onMpTitleChanged() { if (!coverMain.imgPixels) coverMain.requestPaint() }
                            }
                        }

                        Timer {
                            id: blockTimer; interval: 30; repeat: true; running: false
                            property int step: 0; property int steps: 12
                            onTriggered: {
                                step++
                                if (step < steps/2) { coverMain.blockStep=Math.floor(step*3); coverMain.requestPaint() }
                                else if (step === Math.floor(steps/2)) {
                                    if (coverMain.nextImgPixels) { coverMain.imgPixels=coverMain.nextImgPixels; coverMain.nextImgPixels=null }
                                } else { coverMain.blockStep=Math.max(0,Math.floor((steps-step)*3)); coverMain.requestPaint() }
                                if (step >= steps) { running=false; step=0; coverMain.blockStep=0; coverMain.requestPaint() }
                            }
                        }

                        Image {
                            id: coverSrc; width: coverSz; height: coverSz
                            visible: true; opacity: 0; smooth: false; fillMode: Image.PreserveAspectCrop; z: -1
                            onStatusChanged: {
                                if (status !== Image.Ready) return
                                grabToImage(function(result) { extractCanvas.grabResult=result; extractCanvas.requestPaint() }, Qt.size(coverSz, coverSz))
                            }
                        }

                        Canvas {
                            id: extractCanvas; width: coverSz; height: coverSz; visible: false
                            property var grabResult: null
                            onPaint: {
                                if (!grabResult) return
                                var ctx=getContext("2d"); ctx.clearRect(0,0,coverSz,coverSz)
                                ctx.drawImage(grabResult.url,0,0,coverSz,coverSz)
                                var raw=ctx.getImageData(0,0,coverSz,coverSz).data
                                if (coverMain.imgPixels===null) { coverMain.imgPixels=raw; coverMain.requestPaint() }
                                else { coverMain.nextImgPixels=raw; blockTimer.step=0; blockTimer.running=true }
                                coverArea.hoverIntensity=new Array(32*32).fill(0)
                                coverArea.hoverR=new Array(32*32).fill(200)
                                coverArea.hoverG=new Array(32*32).fill(184)
                                coverArea.hoverB=new Array(32*32).fill(154)
                                coverHover.requestPaint()
                            }
                        }

                        Connections {
                            target: root
                            function onMpCoverUrlChanged() {
                                if (root.mpCoverUrl !== "") { coverSrc.source=""; coverSrc.source=root.mpCoverUrl }
                                else { coverMain.imgPixels=null; coverMain.requestPaint() }
                            }
                        }

                        Canvas {
                            id: coverHover; x:20; y:14; width:coverSz; height:coverSz; smooth:false; z:2
                            onPaint: {
                                var ctx=getContext("2d"); var GRID=32,CELL=coverSz/GRID
                                var ci=coverArea.hoverIntensity,cr=coverArea.hoverR,cg=coverArea.hoverG,cb=coverArea.hoverB
                                ctx.clearRect(0,0,coverSz,coverSz)
                                for (var r=0;r<GRID;r++) for (var c=0;c<GRID;c++) {
                                    var i=r*GRID+c
                                    if (ci[i]>0.01) { ctx.fillStyle="rgba("+cr[i]+","+cg[i]+","+cb[i]+","+ci[i]+")"; ctx.fillRect(c*CELL,r*CELL,Math.ceil(CELL)+1,Math.ceil(CELL)+1) }
                                }
                            }
                        }

                        Timer {
                            id: decayTimer; interval:16; repeat:true; running:false
                            onTriggered: {
                                var ci=coverArea.hoverIntensity.slice(); var active=false
                                for (var i=0;i<32*32;i++) { if(ci[i]>0){ci[i]=Math.max(0,ci[i]-0.014);active=true} }
                                coverArea.hoverIntensity=ci; coverHover.requestPaint()
                                if (!active) decayTimer.running=false
                            }
                        }

                        MouseArea {
                            x:20; y:14; width:coverSz; height:coverSz
                            hoverEnabled:true; cursorShape:Qt.CrossCursor
                            onPositionChanged: {
                                var GRID=32,CELL=coverSz/GRID,BRUSH_R=2
                                var cc=Math.floor(mouseX/CELL),cr=Math.floor(mouseY/CELL)
                                var ci=coverArea.hoverIntensity.slice()
                                var cr2=coverArea.hoverR.slice(),cg=coverArea.hoverG.slice(),cb=coverArea.hoverB.slice()
                                var src=coverMain.imgPixels
                                for (var dr=-BRUSH_R;dr<=BRUSH_R;dr++) for (var dc=-BRUSH_R;dc<=BRUSH_R;dc++) {
                                    var nc=cc+dc,nr=cr+dr
                                    if(nc<0||nc>=GRID||nr<0||nr>=GRID) continue
                                    var dist=Math.sqrt(dc*dc+dr*dr)
                                    var alpha=Math.max(0,1-dist/(BRUSH_R+0.5))
                                    var strength=alpha*alpha; if(strength<0.01) continue
                                    if(src){
                                        var sx=Math.min(Math.floor(nc*CELL+CELL/2),coverSz-1)
                                        var sy=Math.min(Math.floor(nr*CELL+CELL/2),coverSz-1)
                                        var idx=(sy*coverSz+sx)*4
                                        if(strength>ci[nr*GRID+nc]*0.6){cr2[nr*GRID+nc]=src[idx];cg[nr*GRID+nc]=src[idx+1];cb[nr*GRID+nc]=src[idx+2]}
                                    }
                                    ci[nr*GRID+nc]=Math.min(1,ci[nr*GRID+nc]+strength*0.9)
                                }
                                coverArea.hoverIntensity=ci;coverArea.hoverR=cr2;coverArea.hoverG=cg;coverArea.hoverB=cb
                                coverHover.requestPaint(); decayTimer.running=true
                            }
                            onExited: decayTimer.running=true
                        }

                        // Scanlines on cover
                        Item { x:20;y:14;width:coverSz;height:coverSz; z:3
                            Repeater { model:33
                                Rectangle { y:index*3+2;width:coverSz;height:1;color:Qt.rgba(0,0,0,0.14) }
                            }
                        }
                        // Right border

                    }

                    // ── Info column ──
                    Item {
                        width: parent.width - coverSz - 40
                        height: coverSz + 28

                        Column {
                            anchors { fill:parent; topMargin:14; leftMargin:20; rightMargin:14; bottomMargin:8 }
                            spacing: 0

                            // Title
                            Text {
                                id: ciTitle; width: parent.width
                                property string targetText: root.mpTitle
                                text: root.mpTitle
                                font.family:"Share Tech Mono"; font.pixelSize:16; font.letterSpacing:1; font.weight:Font.DemiBold
                                color: Qt.rgba(232/255,216/255,184/255,0.95)
                                elide: Text.ElideRight
                                onTargetTextChanged: titleScramble.start()
                                ScrambleAnim { id: titleScramble; target: ciTitle; duration: 400 }
                            }

                            Item { width:1; height:8 }

                            // Artist
                            Text {
                                id: ciArtist; width:parent.width
                                property string targetText: root.mpArtist
                                text: root.mpArtist
                                font.family:"Share Tech Mono"; font.pixelSize:11; font.letterSpacing:1
                                color:Qt.rgba(200/255,184/255,154/255,0.6); elide:Text.ElideRight
                                onTargetTextChanged: artistScramble.start()
                                ScrambleAnim { id: artistScramble; target: ciArtist; duration: 300 }
                            }

                            Item { width:1; height:14 }

                            // Tags
                            Row {
                                spacing: 4
                                Repeater {
                                    model: ["LOSSLESS","48k","FLAC"]
                                    Rectangle {
                                        implicitWidth: tagTxt.implicitWidth+10; height:15
                                        color:"transparent"; border.width:1
                                        border.color: index<2?Qt.rgba(200/255,184/255,154/255,0.3):Qt.rgba(200/255,184/255,154/255,0.14)
                                        Text {
                                            id:tagTxt; anchors.centerIn:parent; text:modelData
                                            font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:1
                                            color: index<2?Qt.rgba(200/255,184/255,154/255,0.65):Qt.rgba(200/255,184/255,154/255,0.35)
                                        }
                                    }
                                }
                            }

                            Item { width:1; height:16 }

                            // Controls
                            Row {
                                spacing: 8
                                CBtn { id:prevBtn; onClicked:root.prevTrack()
                                    Text { anchors.centerIn:parent; text:"◀"; font.pixelSize:10; color:prevBtn.textColor; z:1 } }
                                CBtn { id:playBtn; isPlay:true; onClicked:root.playPause()
                                    Text { anchors.centerIn:parent; text:root.mpPlaying?"PAUSE":"PLAY"
                                        font.family:"Share Tech Mono"; font.pixelSize:9; font.letterSpacing:1; color:playBtn.textColor; z:1 } }
                                CBtn { id:nextBtn; onClicked:root.nextTrack()
                                    Text { anchors.centerIn:parent; text:"▶"; font.pixelSize:10; color:nextBtn.textColor; z:1 } }
                            }

                            Item { width:1; height:14 }

                            // Progress time
                            Item {
                                width:parent.width; height:16
                                Text {
                                    anchors{left:parent.left;verticalCenter:parent.verticalCenter}
                                    text:root.fmtTime(root.mpPosition)
                                    font.family:"Share Tech Mono"; font.pixelSize:9; font.letterSpacing:1
                                    color:Qt.rgba(200/255,184/255,154/255,0.4)
                                }
                                Text {
                                    anchors{right:parent.right;verticalCenter:parent.verticalCenter}
                                    text:root.fmtTime(root.mpLength)
                                    font.family:"Share Tech Mono"; font.pixelSize:9; font.letterSpacing:1
                                    color:Qt.rgba(200/255,184/255,154/255,0.4)
                                }
                            }

                            // Progress bar
                            Item {
                                id:seekBar; width:parent.width; height:16
                                Rectangle {
                                    anchors.verticalCenter:parent.verticalCenter
                                    width:parent.width; height:2; color:Qt.rgba(200/255,184/255,154/255,0.1)
                                }
                                Rectangle {
                                    anchors{verticalCenter:parent.verticalCenter;left:parent.left}
                                    height:2; color:Qt.rgba(200/255,184/255,154/255,0.6)
                                    width:root.mpLength>0?seekBar.width*root.mpPosition/root.mpLength:0
                                }
                                Rectangle {
                                    anchors.verticalCenter:parent.verticalCenter
                                    x:root.mpLength>0?seekBar.width*root.mpPosition/root.mpLength-0.5:0
                                    width:1; height:10; color:Qt.rgba(200/255,184/255,154/255,0.85)
                                }
                                MouseArea {
                                    anchors{fill:parent;topMargin:-6;bottomMargin:-6}
                                    property bool dragging:false
                                    onPressed:{dragging=true;doSeek(mouseX)}
                                    onReleased:{dragging=false}
                                    onPositionChanged:if(dragging)doSeek(mouseX)
                                    function doSeek(mx){
                                        var pct=Math.max(0,Math.min(1,mx/seekBar.width))
                                        seekProc.seekSecs=pct*root.mpLength; seekProc.running=true
                                    }
                                }
                            }

                            Item { width:1; height:12 }

                            // Status row — moved from below cover
                            Row {
                                spacing: 16
                                Row {
                                    spacing: 5
                                    Rectangle {
                                        width:4; height:4; anchors.verticalCenter:parent.verticalCenter
                                        color:root.mpPlaying?Qt.rgba(88/255,158/255,110/255,0.8):Qt.rgba(200/255,184/255,154/255,0.2)
                                        SequentialAnimation on opacity {
                                            running:root.mpPlaying; loops:Animation.Infinite
                                            NumberAnimation{to:0.2;duration:700} NumberAnimation{to:1.0;duration:700}
                                        }
                                    }
                                    Text {
                                        anchors.verticalCenter:parent.verticalCenter
                                        text:root.mpPlaying?"STREAMING":"IDLE"
                                        font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:1
                                        color:root.mpPlaying?Qt.rgba(88/255,158/255,110/255,0.7):Qt.rgba(200/255,184/255,154/255,0.25)
                                    }
                                }
                                Text {
                                    anchors.verticalCenter:parent.verticalCenter
                                    text:root.clockStr
                                    font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:1
                                    color:Qt.rgba(200/255,184/255,154/255,0.25)
                                }
                                Text {
                                    anchors.verticalCenter:parent.verticalCenter
                                    text:"LOSSLESS 48k"
                                    font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:1
                                    color:Qt.rgba(200/255,184/255,154/255,0.2)
                                }
                            }
                        }
                    }
                }

                // ── Queue ──
                Item {
                    width: parent.width; height: queueCol.implicitHeight + 20

                    Rectangle {
                        anchors.top: parent.top
                        x: 0; width: parent.width; height: 1
                        color: Qt.rgba(200/255,184/255,154/255,0.07)
                    }

                    Column {
                        id: queueCol
                        anchors{top:parent.top;left:parent.left;right:parent.right;topMargin:10;leftMargin:14;rightMargin:14}
                        spacing: 0

                        Row {
                            width:parent.width; height:20; spacing:8
                            leftPadding: 12
                            Text {
                                text:"QUEUE"; font.family:"Share Tech Mono"; font.pixelSize:8; font.letterSpacing:3
                                color:Qt.rgba(200/255,184/255,154/255,0.4); anchors.verticalCenter:parent.verticalCenter
                            }
                            Rectangle { width:1; height:8; color:Qt.rgba(200/255,184/255,154/255,0.15); anchors.verticalCenter:parent.verticalCenter }
                            Text {
                                text:"// MPD INTEGRATION PENDING"
                                font.family:"Share Tech Mono"; font.pixelSize:7; font.letterSpacing:1.5
                                color:Qt.rgba(200/255,168/255,74/255,0.4); anchors.verticalCenter:parent.verticalCenter
                            }
                        }

                        Rectangle { width:parent.width; height:1; color:Qt.rgba(200/255,184/255,154/255,0.07) }
                        Item { width:1; height:6 }

                        // Current track
                        Rectangle {
                            width:parent.width; height:44
                            color:Qt.rgba(200/255,184/255,154/255,0.06)
                            Rectangle { width:2; height:parent.height; color:Qt.rgba(200/255,168/255,74/255,0.8) }
                            Row {
                                anchors.fill: parent
                                anchors.leftMargin: 12
                                anchors.rightMargin: 8
                                spacing: 10
                                Text { anchors.verticalCenter:parent.verticalCenter; text:"▶"; font.pixelSize:9; color:Qt.rgba(200/255,168/255,74/255,0.9) }
                                Column {
                                    anchors.verticalCenter:parent.verticalCenter; spacing:4
                                    Text {
                                        id: queueTitle
                                        property string targetText: root.mpTitle
                                        text: root.mpTitle
                                        font.family:"Share Tech Mono"; font.pixelSize:12
                                        font.weight:Font.DemiBold; color:Qt.rgba(232/255,216/255,184/255,0.95)
                                        elide:Text.ElideRight; width: mainCol.width - 80
                                        onTargetTextChanged: queueTitleScramble.start()
                                        ScrambleAnim { id: queueTitleScramble; target: queueTitle; duration: 350 }
                                    }
                                    Text {
                                        id: queueArtist
                                        property string targetText: root.mpArtist
                                        text: root.mpArtist
                                        font.family:"Share Tech Mono"; font.pixelSize:9
                                        color:Qt.rgba(200/255,184/255,154/255,0.65)
                                        elide:Text.ElideRight; width: mainCol.width - 80
                                        onTargetTextChanged: queueArtistScramble.start()
                                        ScrambleAnim { id: queueArtistScramble; target: queueArtist; duration: 250 }
                                    }
                                }
                            }
                        }

                        Repeater {
                            model:["UP NEXT  //  QUEUE EMPTY — CONNECT MPD FOR PLAYLIST SUPPORT",
                                   "ADD TRACKS VIA  mpc add  OR  mpc load <playlist>",
                                   "LOCAL LIBRARY  //  SOULSEEK DOWNLOADS  //  ANY MPD SOURCE"]
                            Item {
                                width:parent.width; height:34
                                Rectangle{anchors.bottom:parent.bottom;width:parent.width;height:1;color:Qt.rgba(200/255,184/255,154/255,0.05)}
                                Text {
                                    anchors{left:parent.left;leftMargin:12;verticalCenter:parent.verticalCenter}
                                    text:modelData; font.family:"Share Tech Mono"; font.pixelSize:9; font.letterSpacing:1
                                    color:Qt.rgba(200/255,184/255,154/255,0.28); elide:Text.ElideRight; width:parent.width-20
                                }
                            }
                        }
                        Item { width:1; height:8 }
                    }
                }
            }
        }
    }

    // ── CRT Reveal ──
    SequentialAnimation {
        id: crtReveal
        PropertyAction  { target:wipeHost; property:"visible";  value:true }
        PropertyAction  { target:wipeHost; property:"crtScale"; value:0.02 }
        NumberAnimation { target:crtFlash; property:"opacity"; to:0.6; duration:60; easing.type:Easing.OutQuart }
        NumberAnimation { target:wipeHost; property:"crtScale"; from:0.02; to:1.0; duration:320; easing.type:Easing.OutExpo }
        NumberAnimation { target:crtFlash; property:"opacity"; to:0.0; duration:180; easing.type:Easing.OutQuart }
    }

    // ── CRT Hide ──
    SequentialAnimation {
        id: crtHide
        onStarted: root.isHiding = true
        NumberAnimation { target:crtFlash; property:"opacity"; to:0.5; duration:60; easing.type:Easing.OutQuart }
        NumberAnimation { target:wipeHost; property:"crtScale"; from:1.0; to:0.02; duration:240; easing.type:Easing.InExpo }
        NumberAnimation { target:crtFlash; property:"opacity"; to:0.0; duration:80 }
        PropertyAction  { target:wipeHost; property:"visible";  value:false }
        PropertyAction  { target:wipeHost; property:"crtScale"; value:0.0 }
        onFinished: root.isHiding = false
    }

    // ── CBtn ──
    component CBtn: Item {
        id: btnRoot
        property bool isPlay: false
        signal clicked
        width:  isPlay ? 60 : 32; height: 26

        Rectangle {
            anchors.fill:parent; color:"transparent"; border.width:1
            border.color:parent.isPlay?Qt.rgba(200/255,184/255,154/255,0.3):Qt.rgba(200/255,184/255,154/255,0.12)
            Rectangle {
                id:cbFill; anchors{left:parent.left;top:parent.top;bottom:parent.bottom}
                width:0; z:0; color:Qt.rgba(200/255,184/255,154/255,0.8)
                Behavior on width{NumberAnimation{duration:200;easing.type:Easing.InOutQuart}}
            }
        }
        property color textColor: cbMa.containsMouse?"#0b0a09":(isPlay?Qt.rgba(200/255,184/255,154/255,0.85):Qt.rgba(200/255,184/255,154/255,0.4))
        MouseArea {
            id:cbMa; anchors.fill:parent; hoverEnabled:true
            onEntered:cbFill.width=btnRoot.width; onExited:cbFill.width=0
            onClicked:btnRoot.clicked(); onPressed:btnRoot.scale=0.95; onReleased:btnRoot.scale=1.0
        }
    }
}
